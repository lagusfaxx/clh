# =============================================================================
# Dockerfile.worker - BullMQ worker (recreation + narration)
# =============================================================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat vips
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# Install workspace deps
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/ai/package.json ./packages/ai/
COPY packages/ui/package.json ./packages/ui/
COPY packages/ingest/package.json ./packages/ingest/
RUN pnpm install --frozen-lockfile

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm --filter @chile-historico/db prisma generate

# Runner
FROM base AS runner
ENV NODE_ENV=production
RUN addgroup -g 1001 -S nodejs \
 && adduser -u 1001 -S worker -G nodejs

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/worker ./apps/worker
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/package.json ./

USER worker

CMD ["node", "--experimental-specifier-resolution=node", "--loader", "tsx", "apps/worker/src/index.ts"]
